{
	"name": "@donnes/syncode",
	"version": "1.1.9",
	"description": "Sync AI coding agent instructions, skills and configs (Claude Code, Codex, OpenCode, Gemini CLI, Cursor, Copilot) across machines.",
	"private": false,
	"type": "module",
	"bin": {
		"syncode": "./dist/index.mjs"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "node src/index.ts",
		"build": "tsdown",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"check": "bun run lint && bun run typecheck && bun run test && bun run build",
		"prepublishOnly": "bun run build"
	},
	"keywords": [
		"ai-agents",
		"agent-skills",
		"agents-md",
		"claude-code",
		"codex",
		"opencode",
		"gemini-cli",
		"cursor",
		"copilot",
		"dotfiles",
		"syncode"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "bun@1.4.3",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/donnes/syncode.git"
	},
	"bugs": {
		"url": "https://github.com/donnes/syncode/issues"
	},
	"homepage": "https://github.com/donnes/syncode#readme",
	"author": "Donald Silveira",
	"license": "MIT",
	"dependencies": {
		"@clack/prompts": "^1.8.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@types/node": "^22.18.0",
		"tsdown": "^0.23.1",
		"typescript": "~7.0.2",
		"vitest": "^5.0.5"
	}
}
